config/config.php
config/config.test.php
logs/
seed*.php
node_modules/

# Stray documents dropped into the fixtures directory. What belongs there is
# the CSVs and the generator, all of them tiny and readable; a PDF or a
# spreadsheet landing here is something someone parked mid-task, not a
# fixture, and it should not be staged by a careless "git add .".
database/fixtures/*.pdf
database/fixtures/*.xlsx
database/fixtures/*.docx

# Database dumps. These carry live data and password hashes, so they must never
# be committed. Anchored to the repository root so database/schema.sql, which is
# structure only and IS tracked, stays unaffected.
/*-backup-*.sql

# Personal Claude Code permissions for this checkout. This one file only: the
# rest of .claude/ may hold settings meant to be shared.
/.claude/settings.local.json
